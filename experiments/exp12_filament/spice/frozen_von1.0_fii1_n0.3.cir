wrdata /mnt/e/quantum_cell/experiments/exp12_filament/spice/frozen_von1.0_fii1_n0.3_dn.dat -i(Vd) v(b) @m.x1.msky130_fd_pr__nfet_01v8[isub]
quit
.endc
.end
